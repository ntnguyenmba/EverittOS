# App URL (auth redirects, password reset, Google Calendar OAuth)
NEXT_PUBLIC_APP_URL=https://app.everittventures.com
# Local dev: http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://wxtatzlirexrwjehqgak.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias (same value as ANON_KEY):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=you@everittventures.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for Checkout Sessions (required for in-app promo checkout)
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
# Optional: configure Stripe Customer Portal in the Stripe Dashboard for self-serve billing.
# Promotion codes (FOUNDING, EVERITTVIP, STAY25, EVERITTTEAM) are managed in Stripe Dashboard.

# Session security (optional; default 30 minutes idle, 5 minute warning)
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_IDLE_WARNING_MINUTES=5

# Account status (run supabase/migrations/202605360001_account_status.sql)
# profiles.account_status: active | disabled

# Auth redirect URLs (Supabase Dashboard > Authentication > URL Configuration)
# Site URL: NEXT_PUBLIC_APP_URL
# Redirect URLs: {APP_URL}/confirm-email, {APP_URL}/auth/callback, {APP_URL}/reset-password
# Auth emails: Supabase Auth only (see docs/SUPABASE_AUTH_EMAIL_TEMPLATES.md)

# Email (optional — auth uses Supabase only; invites fall back to copy-link)
RESEND_API_KEY=
EMAIL_FROM=EverittOS <notifications@yourdomain.com>

# AI provider (server only — never use NEXT_PUBLIC_ for API keys)
# AI_PROVIDER=openai | deepseek | ollama | qwen | gemini | anthropic
AI_PROVIDER=openai
# Shared overrides (optional — apply to the active provider)
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# OpenAI (default provider)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# EVERITTTEAM shared AI budget (USD per calendar month)
AI_EVERITTTEAM_MONTHLY_BUDGET_USD=10

# DeepSeek (OpenAI-compatible)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Ollama (local — no API key required)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Qwen / DashScope (OpenAI-compatible)
# QWEN_API_KEY=
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Calendar OAuth (Settings → Integrations)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy aliases (optional if GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are set):
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://app.everittventures.com/api/integrations/google-calendar/callback
# Optional: GOOGLE_CALENDAR_OAUTH_STATE_SECRET=
