# App URL (auth redirects, password reset, Google Calendar OAuth)
NEXT_PUBLIC_APP_URL=https://app.everittventures.com
# Local dev: http://localhost:3000

# Capacitor native shells (optional)
# CAPACITOR_SERVER_URL=https://app.everittventures.com
# CAPACITOR_DEV=true
# Local native debugging only: CAPACITOR_SERVER_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://wxtatzlirexrwjehqgak.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias (same value as ANON_KEY):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=you@everittventures.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Canonical Stripe IDs used by the current billing catalog.
STRIPE_PRICE_PRO=price_1U26yd2KsjgU9g9yjipBM4gy
STRIPE_PRICE_BUSINESS=price_1TcwxB2KsjgU9g9y57f9veQh
STRIPE_PRICE_STARTER=price_1U27SR2KsjgU9g9ybeGRo9Iy
STRIPE_PRICE_GROWTH=price_1U2Kge2KsjgU9g9ypMeHRfxb
STRIPE_PRICE_ENTERPRISE=price_1U2KlI2KsjgU9g9yeak0iPiT
STRIPE_PRODUCT_PRO=prod_UcTW6bzlGX2eEu
STRIPE_PRODUCT_BUSINESS=prod_UcBJxRbYFgf2jo
STRIPE_PRODUCT_STARTER=prod_Uah29K2LrfDj5h
STRIPE_PRODUCT_GROWTH=prod_Uah3w3NgG6zloO
STRIPE_PRODUCT_ENTERPRISE=prod_Uah64aXMtVGGqI
# Optional: configure Stripe Customer Portal in the Stripe Dashboard for self-serve billing.
# Promotion codes are entered in Stripe Checkout / Customer Portal — not validated in-app.

# Native store product IDs (public — used by Capacitor shells)
NEXT_PUBLIC_IOS_PRO_MONTHLY_PRODUCT_ID=com.everittventures.everittos.pro.monthly.v3
NEXT_PUBLIC_IOS_BUSINESS_MONTHLY_PRODUCT_ID=com.everittventures.everittos.business.monthly.v2
NEXT_PUBLIC_IOS_STARTER_MONTHLY_PRODUCT_ID=com.everittventures.everittos.starter.monthly.v4
NEXT_PUBLIC_IOS_GROWTH_MONTHLY_PRODUCT_ID=com.everittventures.everittos.growth.monthly.v2
NEXT_PUBLIC_IOS_ENTERPRISE_MONTHLY_PRODUCT_ID=com.everittventures.everittos.enterprise.monthly.v2
NEXT_PUBLIC_ANDROID_PRO_SUBSCRIPTION_ID=everittos_pro
NEXT_PUBLIC_ANDROID_BUSINESS_SUBSCRIPTION_ID=everittos_business
NEXT_PUBLIC_ANDROID_MONTHLY_BASE_PLAN_ID=monthly

# Apple App Store Server API (server only — never expose to the client)
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_BUNDLE_ID=com.everittventures.everittos
# APPLE_APP_ID=
# APPLE_IN_APP_PURCHASE_PRIVATE_KEY=
# APPLE_ENVIRONMENT=Sandbox

# Google Play Developer API (server only)
# Preferred on Vercel: keyless Workload Identity Federation using Vercel OIDC.
# In Google Cloud, allow the Vercel OIDC provider to impersonate the service account,
# and grant that service account Google Play Console API access.
# GOOGLE_PLAY_PACKAGE_NAME=com.everittventures.everittos
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# GCP_SERVICE_ACCOUNT_EMAIL=
# VERCEL_OIDC_TOKEN is supplied automatically by Vercel when OIDC is enabled.
#
# Optional legacy/local fallback. Do not use this when keyless auth is configured.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# GOOGLE_PLAY_PUBSUB_VERIFICATION_TOKEN=
# GOOGLE_PLAY_PUBSUB_AUDIENCE=

# Session security (optional; default 8 hours idle, 5 minute warning, 7 day absolute lifetime)
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_IDLE_WARNING_MINUTES=5
SESSION_ABSOLUTE_HOURS=168

# Account status (run supabase/migrations/202605360001_account_status.sql)
# profiles.account_status: active | disabled

# Auth redirect URLs (Supabase Dashboard > Authentication > URL Configuration)
# Site URL: NEXT_PUBLIC_APP_URL
# Redirect URLs: {APP_URL}/confirm-email, {APP_URL}/auth/callback, {APP_URL}/reset-password
# Auth emails: Supabase Auth only (see docs/SUPABASE_AUTH_EMAIL_TEMPLATES.md)

# Email (optional — auth uses Supabase only; invites fall back to copy-link)
RESEND_API_KEY=
EMAIL_FROM=EverittOS <notifications@yourdomain.com>

# AI provider (server only — never use NEXT_PUBLIC_ for API keys)
# AI_PROVIDER=openai | deepseek | ollama | qwen | gemini | anthropic
AI_PROVIDER=openai
# Shared overrides (optional — apply to the active provider)
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# OpenAI (default provider)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# EVERITTTEAM shared AI budget (USD per calendar month)
AI_EVERITTTEAM_MONTHLY_BUDGET_USD=10

# DeepSeek (OpenAI-compatible)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Ollama (local — no API key required)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Qwen / DashScope (OpenAI-compatible)
# QWEN_API_KEY=
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Calendar Import stores private iCal/ICS subscription URLs in the database
# (server-side only). Do not put a calendar feed URL in environment variables.

# Google Calendar OAuth (Settings → Integrations)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy aliases (optional if GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are set):
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://app.everittventures.com/api/integrations/google-calendar/callback
# Optional: GOOGLE_CALENDAR_OAUTH_STATE_SECRET=

# QuickBooks OAuth (Settings → Integrations) — server only, never NEXT_PUBLIC_
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://app.everittventures.com/api/integrations/quickbooks/callback
# sandbox | production  (use sandbox for local/preview; production credentials only on Vercel Production)
QUICKBOOKS_ENVIRONMENT=sandbox
# Required HMAC secret for signed OAuth state (server only)
QUICKBOOKS_STATE_SECRET=
